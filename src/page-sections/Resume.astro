---
import type PageSections from '@/interfaces/PageSections'
import ThemeController from '@components/form/ThemeController.vue'
import LanguageSelection from '@components/navigation/LanguageSelection.vue'
import MainNavbar from '@components/navigation/MainNavbar.astro'
import DockMainNavbar from '@components/navigation/DockMainNavbar.astro'
import Socials from '@components/navigation/Socials.astro'
import _ from 'lodash'
import { __ } from '@config/i18n'
import { getRelativeLocaleUrl } from 'astro:i18n'

interface Props extends PageSections {
    classList?: string
}

const { lang, classList = 'lg:col-span-2' } = Astro.props as Props

const homeUrl = getRelativeLocaleUrl(lang, '/')
const navigationLabel = __('navigation.primary', { lng: lang })
const navigationLinks = [
    {
        href: '#about',
        label: __('navigation.items.about', { lng: lang }),
        icon: 'user',
    },
    {
        href: '#experience',
        label: __('navigation.items.experience', { lng: lang }),
        icon: 'briefcase',
    },
    {
        href: '#projects',
        label: __('navigation.items.projects', { lng: lang }),
        icon: 'code',
    },
    {
        href: '#favorite-tools',
        label: __('navigation.items.favorite-tools', { lng: lang }),
        icon: 'tool',
    },
    {
        href: '#education',
        label: __('navigation.items.education', { lng: lang }),
        icon: 'award',
    },
    {
        href: '#contact',
        label: __('navigation.items.contact', { lng: lang }),
        icon: 'mail',
    },
]
const contactHref = 'mailto:carminemaggiom@gmail.com'
const navigationHomeLabel = __('navigation.home', { lng: lang })
---

<section class={classList}>
    <div
        class='flex flex-col justify-between gap-10 pt-16 pb-4 lg:sticky lg:top-0 lg:h-screen lg:py-20'
    >
        <article>
            <p
                class='border-base-content/10 bg-base-content/[0.03] text-base-content/80 mb-6 inline-flex items-center gap-2.5 rounded-full border px-3 py-1.5 font-mono text-xs'
            >
                <span class='status-dot' aria-hidden='true'></span>
                {__('status', { lng: lang })}
            </p>
            <h1 class='h1' id='resume-heading'>Carmine<br />Maggio</h1>
            <p class='h4 text-base-content! mt-5 mb-1'>{__('systems-engineer', { lng: lang })}</p>
            <h2 class='text-rotate h4 text-primary duration-20000'>
                <span>
                    {
                        _.map(
                            __('main-specializations', { lng: lang, returnObjects: true }),
                            (specialization: string) => <span>{specialization}</span>
                        )
                    }
                </span>
            </h2>
            <p class='mt-4 max-w-sm text-sm xl:text-base'>{__('presentation', { lng: lang })}</p>

            <div class='mt-7 flex flex-wrap items-center gap-3'>
                <a href={contactHref} class='btn btn-primary rounded-full px-6'>
                    <i data-feather='mail' class='w-4'></i>
                    {__('contact.cta', { lng: lang })}
                </a>
                <a href='#projects' class='btn btn-ghost rounded-full'>
                    {__('navigation.items.projects', { lng: lang })}
                    <i data-feather='arrow-down-right' class='w-4'></i>
                </a>
            </div>

            <MainNavbar
                lang={lang}
                homeUrl={homeUrl}
                label={navigationLabel}
                links={navigationLinks}
                homeLabel={navigationHomeLabel}
            />
        </article>
        <aside
            aria-label={__('socials.label', { lng: lang })}
            class='flex flex-wrap items-center justify-between gap-4'
        >
            <Socials lang={lang} />
            <div class='flex items-center gap-3'>
                <ThemeController client:load />
                <LanguageSelection lang={lang} client:idle />
            </div>
        </aside>
    </div>
</section>

<DockMainNavbar
    lang={lang}
    links={navigationLinks}
    homeLabel={navigationHomeLabel}
    homeIcon='home'
    homeUrl={homeUrl}
    contactHref={contactHref}
    contactLabel={__('navigation.items.contact', { lng: lang })}
/>
