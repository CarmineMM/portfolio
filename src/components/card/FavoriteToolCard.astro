---
import type PageSections from '@/interfaces/PageSections'
import { __ } from '@config/i18n'

interface Props extends PageSections {}

const { lang } = Astro.props

const tools = [
    {
        name: 'Rigels.io',
        description: __('tools.rigels.description', { lng: lang }),
        url: 'https://rigels.io',
    },
    {
        name: 'VSCode',
        description: 'A powerful code editor',
        url: 'https://code.visualstudio.com',
    },
    {
        name: 'Postman',
        description: 'A powerful API testing tool',
        url: 'https://www.postman.com',
    },
    {
        name: 'Docker',
        description: 'A powerful containerization tool',
        url: 'https://www.docker.com',
    },
    {
        name: 'Hetzner Cloud',
        description: 'A powerful cloud hosting solution',
        url: 'https://hetzner.cloud/?ref=78heXd5pCb9w',
    },
    {
        name: 'GitHub Actions',
        description: 'A powerful CI/CD tool',
        url: 'https://docs.github.com/en/actions',
    },
    {
        name: 'AWS',
        description: 'A powerful cloud hosting solution',
        url: 'https://aws.amazon.com',
    },
]
---

<ul class='grid grid-cols-2 gap-3 sm:grid-cols-3'>
    {
        tools.map((tool) => (
            <li>
                <a
                    href={tool.url}
                    target='_blank'
                    rel='noopener noreferrer'
                    class='group border-base-content/10 bg-base-200/60 hover:border-primary/50 hover:text-primary flex items-center justify-between gap-2 rounded-xl border px-4 py-3 text-sm font-medium transition-colors'
                >
                    <span>{tool.name}</span>
                    <i
                        data-feather='arrow-up-right'
                        class='w-4 opacity-40 transition-opacity group-hover:opacity-100'
                    />
                </a>
            </li>
        ))
    }
</ul>
