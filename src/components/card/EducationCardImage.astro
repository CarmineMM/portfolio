---
interface Props {
    logoUrl?: string
    institution?: string
    classList?: string
}

const { logoUrl, institution, classList } = Astro.props
---

{
    logoUrl ? (
        <img
            src={logoUrl}
            alt={`${institution} logo`}
            class:list={['max-h-14 rounded-lg object-contain', classList]}
        />
    ) : (
        <div
            class:list={[
                'bg-primary/10 text-primary flex h-14 w-14 items-center justify-center rounded-xl',
                classList,
            ]}
        >
            <i data-feather='book-open' class='w-6' />
        </div>
    )
}
