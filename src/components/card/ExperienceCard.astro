---
import type { Experience } from '@/entities/Experience'
import type PageSections from '@/interfaces/PageSections'
import { __ } from '@config/i18n'

interface Props extends PageSections {
    experience: Experience
}

const { experience, lang = 'es' } = Astro.props as Props
const headingId = `experience-${experience.id}-heading`
const technologiesLabel = __('experience.technologies', { lng: lang })
const durationLabel = experience.getDuration(lang)
---

<article class='card card-side experience-card surface-card' aria-labelledby={headingId}>
    <div class='card-body hidden items-start md:flex md:max-w-32 md:min-w-32 md:pr-0'>
        <!-- Logo Url -->
        {
            experience.companyLogoUrl && (
                <a
                    class='block w-17'
                    href={experience.companyWebsiteUrl}
                    target='_blank'
                    rel='noopener noreferrer'
                    title={experience.company}
                >
                    <img
                        src={experience.companyLogoUrl}
                        alt={experience.company}
                        class='rounded-lg'
                        loading='lazy'
                    />
                </a>
            )
        }

        <!-- Tiempo -->
        <p
            class='lg:tooltip xl:tooltip-left text-base-content/50! mt-2 font-mono text-xs capitalize'
            data-tip={durationLabel}
            aria-label={durationLabel}
        >
            <span>{experience.getStartDateYear()}</span>
            <span>-</span>
            <span>{experience.getEndDateYear()}</span>
            <span class='sr-only'>{durationLabel}</span>
        </p>
    </div>
    <div class='card-body overflow-hidden'>
        <h3 class='card-title' id={headingId}>
            {
                experience?.companyWebsiteUrl ? (
                    <a
                        href={experience.companyWebsiteUrl}
                        target='_blank'
                        rel='noopener noreferrer'
                        class='link link-hover'
                        title={experience.company}
                    >
                        {experience.company}
                    </a>
                ) : (
                    experience.company
                )
            }
        </h3>
        <h4 class='text-base-content/90 font-medium'>{experience.role}</h4>
        <p class='text-base-content/50! mb-0 font-mono text-xs capitalize md:hidden'>
            {durationLabel}
        </p>
        {
            experience.address && (
                <p class='text-base-content/50! mb-0 text-xs'>{experience.address}</p>
            )
        }
        <p class='mt-2 text-sm' set:html={experience.description} />

        <ul class='flex gap-2 overflow-auto pb-1 lg:flex-wrap' aria-label={technologiesLabel}>
            {
                experience.technologies.map((technology) => (
                    <li>
                        <a
                            href={technology.webUrl}
                            target='_blank'
                            rel='noopener noreferrer'
                            title={technology.name}
                            class='tech-pill'
                        >
                            {technology.name}
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
</article>
